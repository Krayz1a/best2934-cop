# --- MANDATORY: OAuth / Gmail secrets (book rules 39-40) -------------------
# A secret pushed once is compromised forever -- deleting it in a later commit
# does NOT remove it from git history. These files must never be committed,
# even to a private repository shared only with the lecturer.
credentials.json
token.json
*credentials*.json
*token*.json
client_secret*.json
.env
.env.*
*.pem
*.key

# --- Anthropic / LLM credentials -------------------------------------------
.anthropic/
anthropic.json

# --- Match artifacts (regenerated per game; logs are attached to the report)
logs/*.json
logs/*.log
artifacts/*.json
# Sent-mail receipts: they carry opponents' addresses, and both repos are public.
artifacts/*.eml
artifacts/**/*.eml
!artifacts/.gitkeep
!logs/.gitkeep

# --- Test and coverage output ----------------------------------------------
# `results/` itself IS committed: the experiment data behind the analysis
# notebook is part of the submission. Only generated coverage HTML is ignored.
results/coverage/
htmlcov/
.coverage
.coverage.*
coverage.xml

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
dist/
build/

# --- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
# The counted-series tree: same reason as artifacts/*.json, but the glob above
# is non-recursive so a subdirectory slips through. An untracked directory here
# also makes every github_commit stamp read "-dirty" during a counted series.
artifacts/counted/
artifacts/outside_declared_series/
