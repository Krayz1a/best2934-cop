# ---------------------------------------------------------------------------
# Environment template — COMMITTED. Copy to `.env` and fill in real values.
# `.env` itself is git-ignored and must never be pushed (guidelines §7.4,
# book rules 39-40). Every value below is a PLACEHOLDER, not a real secret.
# ---------------------------------------------------------------------------

# --- Anthropic API (optional) ----------------------------------------------
# Only needed when trash_talk.provider = "claude_api". The match is fully
# playable with provider = "template", which costs zero tokens.
ANTHROPIC_API_KEY=sk-ant-REPLACE-WITH-YOUR-OWN-KEY

# --- Gmail reporting (book rule 33) ----------------------------------------
# Paths to the OAuth client file you download from Google Cloud Console and
# the token the consent flow writes. Both files are git-ignored.
# Scope MUST be send-only: https://www.googleapis.com/auth/gmail.send (rule 30).
P2PCHASE_GMAIL_SENDER=your.agent.address@gmail.com
P2PCHASE_GMAIL_CREDENTIALS=./credentials.json
P2PCHASE_GMAIL_TOKEN=./token.json

# --- Step-0 declaration signing --------------------------------------------
# Any high-entropy string. Signs the hardware declaration so a team cannot
# retroactively claim weaker hardware to farm the fairness bonus (rule 24).
P2PCHASE_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string

# --- Optional overrides -----------------------------------------------------
# Set when the package is installed as a wheel and the checkout lives elsewhere.
# P2PCHASE_ROOT=/path/to/best2934-cop
